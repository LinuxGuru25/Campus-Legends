label hallway_text:

    scene bg hallway_day

    "The classroom door shut behind me."

    "My phone buzzed in my pocket."

    MCname "Huh?"

    "I pulled it out and saw a new message from the frat."

    show screen phone_message

    "The first Rush Week Challenge."

    "{i}Complete ONE of the following:{/i}"

    "1. Sneak into the FLAUNT house and steal a pair of panties."

    "2. Sneak into Professor Hart's office and steal tomorrow's lesson plans."

    MCname "You've got to be kidding me..."

    MCname "Both of these are terrible ideas."

    menu:
        "Which challenge do you attempt?"

        "Steal panties from the FLAUNT house":
            $ rush_choice = "flaunt"

        "Steal Professor Hart's lesson plans":
            $ rush_choice = "hart"

    scene black with fade

    centered "{size=+20}Later That Afternoon...{/size}"

    pause 1.5

    if rush_choice == "flaunt":
        jump rush_flaunt
    else:
        jump rush_hart


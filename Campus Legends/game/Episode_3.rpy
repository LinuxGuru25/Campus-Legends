label thursday_afternoon:
    #scene classroom_afternoon
    with dissolve

    MCname "{i}(Afternoon class. Let's try to stay awake.){/i}"
    ProfessorHart "Welcome back, everyone."
    ProfessorHart "I hope your morning was productive."
    MCname "{i}(Mine involved sprinting across campus and a shower that barely counted.){/i}"
    ProfessorHart "Today we're moving into Thesis Development."
    ProfessorHart "Which means..you'll be assigned 2 partners and you will come up with a topic and give me a clear and concise thesis statement"
    ProfessorHart "The topic can be anything you choose i wont force an artifical subject on you because thats would hinder your writing potential"
    #MC dozing off
    ProfessorHart "So i'll assign..."
    #Hart walks up to the MCs row and looks at him sleeping
    ProfessorHart "[MCname] can you tell me what i just said?"
    #MC still dead to the world
    ProfessorHart "[MCname] WAKE UP"
    #MC jolts awake
    MCname "Ugh im sorry"
    ProfessorHart "Long night?"
    MCname "Yeah....you could say that"
    ProfessorHart "We'll finish this discussion after class,please come see me after class [MCname]"
    ProfessorHart "Now that everyone is awake lets get you in your groups"
    ProfessorHart "[MCname],Kaia.and Tiffany will be group one"
    #She continues to call out groups
    #Tiff sits next to the mc giving him little personal space
    MCname "......"
    Tiff "Looks like we're partners babe"
    Kaia "tIFF..."
    Tiff "what?"
    Kaia "Give the man some space girl you might as well be sitting in his lap"
    #tIFF JUMPS IN UR LAP
    Tiff "No..this is in his lap"
    "{i}(.....){/i}"
    Tiff "{i}{size=-8}What's the matter? Cat got your tongue...{/size}{/i}"
    #Tiff wiggles her bottom slightly to get a rise out of you
    menu:
        "Indulge her.\n{color=#00ff00}{i}[Tiff +1]{/i}{/color}":
            $ relationship_api.add_affection("Tiff", 1)
            $ walkthrough("Tiff +1")
            $ indulged_tiff = True
            MCname "{i}(…What a little tease.){/i}"
            #MC puts his hand on her thigh
            MCname "{i}(…Lets see how she reacts to that..){/i}"
            #Tiff spreads her legs a little an invitation
            jump after_tiff_interaction
        "Ask her to get off you.":
            MCname "Hey—can you move?"
            $ indulged_tiff = False
            jump Tiff_Rejection

label Tiff_Rejection:
    # Tiff reacts to the MC pulling away
    Tiff "Right. Sorry. Got carried away."
    MCname "{i}(She backs off. Awkward… but not catastrophic.){/i}"
    # Small reset so the scene continues normally
    Tiff "Let's just finish the assignment."
    MCname "{i}(Probably for the best.){/i}"

label after_tiff_interaction:
    Kaia "......"
    Kaia "{i}(This got really ackward....i better break the tension before it gets anymore ackward){/i}"
    Kaia "So [MCname] you coming back to the gym soon?"
    MCname "Hell yeah i'm actually really looking foward to it, last workout did me hella good"
    if indulged_tiff:
        Tiff "Maybe we can work on our cardio together sometime"
        MCname "I'd love to work you...work out with you..."
        #MC laughs nervously
    else:
        Tiff "Good. You should keep at it."
